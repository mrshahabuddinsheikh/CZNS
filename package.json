{
  "name": "czns-mobile-store",
  "version": "1.0.0",
  "private": true,
  "description": "CZNS - Pakistani Mobile Store E-Commerce Platform (New & Used Phones)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "seed": "npm run seed --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "start:web": "npm run start --workspace=apps/web"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.469.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "keywords": [
    "mobile-store",
    "pakistan",
    "ecommerce",
    "iphone",
    "samsung",
    "czns"
  ],
  "author": "CZNS",
  "license": "MIT"
}
